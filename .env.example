# Server port (AI Studio uses 3000)
PORT=3000

# Optional Gemini API key for live AI resume parsing (server-side only).
# When unset, SkillBridge AI uses transparent local deterministic text extraction (Demo Mode).
GEMINI_API_KEY=

# Optional external API base URL for independent backend testing (leave blank for same-origin /api)
# VITE_API_BASE_URL=http://localhost:3000

# Future Target B (Supabase integration placeholders — not used in Target A)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
